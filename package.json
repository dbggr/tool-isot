{
  "name": "infra-source-truth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:unit": "jest --testPathPattern=unit",
    "test:coverage": "jest --coverage",
    "db:init": "ts-node --project scripts/tsconfig.json scripts/init-db.ts",
    "db:seed": "ts-node --project scripts/tsconfig.json scripts/seed-db.ts",
    "db:test": "ts-node --project scripts/tsconfig.json scripts/test-db.ts",
    "db:test-startup": "ts-node --project scripts/tsconfig.json scripts/test-startup-init.ts",
    "db:reset": "rm -f data/network-source-truth.db && npm run db:init && npm run db:seed",
    "db:reset-test": "rm -f data/network-source-truth-test.db",
    "api:test": "curl -s http://localhost:3000/api/health | jq .",
    "api:docs": "echo 'API Documentation available at: docs/api-documentation.md'",
    "setup": "npm install && npm run db:init && npm run db:seed",
    "clean": "rm -rf .next && rm -rf node_modules/.cache && npm run db:reset",
    "verify": "npm run lint && npm run test && npm run build",
    "verify:requirements": "ts-node --project scripts/tsconfig.json scripts/verify-requirements.ts",
    "verify:responsive": "ts-node --project scripts/tsconfig.json scripts/verify-responsive.ts",
    "verify:full": "npm run verify && npm run verify:requirements && npm run verify:responsive",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "BUNDLE_ANALYZE=browser npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-window": "^2.3.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.29",
    "supertest": "^7.3.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.3.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "postcss-selector-parser": "^7.1.6",
    "sharp": "^0.35.5",
    "eslint": "$eslint"
  }
}
